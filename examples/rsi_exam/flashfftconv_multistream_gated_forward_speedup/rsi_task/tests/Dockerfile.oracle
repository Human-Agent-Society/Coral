ARG VERIFIER_IMAGE
FROM ${VERIFIER_IMAGE}

LABEL ai.autoresearch.role="author-anchor-measurement"

# Carries the human-SOTA kernel, so it must never score an agent submission.
# The root-only sentinel lets grade.py skip the submission guard for anchors.
RUN pip install --no-cache-dir packaging ninja setuptools wheel \
    && pip install --no-cache-dir --no-build-isolation git+https://github.com/HazyResearch/flash-fft-conv@b8771028717f46d5b22cbb8e12833f35033d621b \
    && python -c "import flashfftconv" \
    && touch /tests/oracle_mode \
    && chmod 0400 /tests/oracle_mode
